# Copy to cloud/.env and fill in. cloud/.env is git-ignored.
# Then:  cloud/run_remote.sh        (or push and run the "GPU benchmark" workflow)

# --- where the GPU machine comes from ---------------------------------------
# manual  : you already have a machine; give its SSH address below
# <name>  : cloud/providers/<name>.sh creates and destroys one with the API key
GPU_PROVIDER=manual
GPU_PROVIDER_API_KEY=

# manual provider (also used by every provider once the machine exists)
GPU_SSH_HOST=
GPU_SSH_USER=ubuntu
GPU_SSH_KEY=~/.ssh/id_ed25519          # private key path; CI writes GPU_SSH_PRIVATE_KEY here

# --- what runs on it ---------------------------------------------------------
HF_TOKEN=                             # Hugging Face token with Llama 3 access
TRIALS=3                              # benchmark trials per mode
TOOL=loadgen                          # loadgen | inference-perf
NBODY=1                               # 1 = also run the N-body benchmarks at the end
MONITORING=1                          # 1 = install Prometheus/Loki/Grafana first
KEEP_INSTANCE=0                       # 1 = do not destroy the machine when done

# --- optional -----------------------------------------------------------------
MODEL=meta-llama/Meta-Llama-3-8B-Instruct
VLLM_IMAGE=vllm/vllm-openai:latest
GATEWAY_URL=                          # empty = use the built-in prefix-affinity router
